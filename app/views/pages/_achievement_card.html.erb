<div class="achievement-card">
  <div class="flex justify-between items-start">
    <div>
      <span class="achievement-badge <%= achievement.badge_class %>"><%= achievement.badge_emoji %> <%= achievement.badge_label %></span>
      <h3 class="achievement-title">
        <%= link_to achievement.title, achievement.github_url, target: "_blank", rel: "noopener" %>
      </h3>
      <p class="achievement-event"><%= achievement.full_event %></p>
    </div>
    <span class="achievement-prize"><%= achievement.formatted_prize %></span>
  </div>
  <p class="achievement-desc"><%= achievement.description %></p>
</div>
