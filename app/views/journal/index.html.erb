<% content_for :title, "Journal" %>
<% content_for :meta_description, "Notes and writings on what I'm building and learning." %>

<%= stylesheet_link_tag "journal", "data-turbo-track": "reload" %>

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
  <div class="mb-6 sm:mb-8">
    <%= link_to "← Home", root_path, class: "text-[#41CFFF] hover:text-[#E58C2E] transition-colors" %>
  </div>

  <header class="mb-8 sm:mb-10 pb-6 border-b-2 border-[#3B2C22]/10">
    <h1 class="text-3xl sm:text-4xl font-bold text-[#3B2C22] mb-2">Journal</h1>
    <p class="text-[#3B2C22]/60">Notes on what I'm building and learning.</p>
  </header>

  <% if @posts.any? %>
    <ul class="journal-list">
      <% @posts.each do |post| %>
        <li class="journal-list-item">
          <%= link_to journal_post_path(post), class: "journal-list-link" do %>
            <h2 class="journal-list-title"><%= post.title %></h2>
          <% end %>
          <div class="journal-list-meta">
            <% if post.published_on %><time datetime="<%= post.published_on.iso8601 %>"><%= post.published_on.strftime("%B %-d, %Y") %></time> · <% end %>
            <span><%= post.reading_time %> min read</span>
          </div>
          <p class="journal-list-summary"><%= post.summary %></p>
          <% if post.tags.present? %>
            <div class="journal-tags">
              <% post.tags.each do |tag| %><span class="journal-tag"><%= tag %></span><% end %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-[#3B2C22]/50">No posts yet. Check back soon.</p>
  <% end %>
</div>
